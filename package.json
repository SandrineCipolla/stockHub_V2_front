{
  "name": "stockhub-v2-front",
  "private": true,
  "version": "1.17.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File ./kill-vite.ps1 && npm run dev",
    "kill-vite": "powershell -ExecutionPolicy Bypass -File ./kill-vite.ps1",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:with-sitemap": "npm run generate-sitemap && npm run build",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "detect:as-const": "node scripts/detect-as-const.mjs",
    "clean:deadcode": "knip --config knip.json",
    "clean:fix": "knip --fix",
    "clean:check": "npm run type-check && npm run lint && npm run clean:deadcode",
    "check:strict": "npm run detect:as-const && npm run lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:fps": "node scripts/audit-fps.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:datasets": "node scripts/audit-datasets.mjs",
    "audit:colorblind": "node scripts/audit-colorblind.mjs",
    "audit:wcag": "node scripts/audit-wcag.mjs",
    "audit:full": "node scripts/audit-full.mjs",
    "generate:a11y": "node scripts/generate-a11y.mjs",
    "generate:wcag": "node scripts/generate-wcag.mjs",
    "generate:eco": "node scripts/generate-eco.mjs",
    "generate:coverage": "node scripts/generate-coverage.mjs",
    "generate:lighthouse": "node scripts/generate-lighthouse.mjs",
    "generate:all": "node scripts/generate-all.mjs",
    "merge:audits": "node scripts/merge-audits.mjs",
    "metrics:update": "node scripts/update-metrics-files.mjs",
    "metrics:dashboard": "npm run generate:all && npm run metrics:update",
    "metrics:serve": "node scripts/serve-metrics.mjs",
    "ci:quality": "npm run type-check && npm run lint && npm run clean:deadcode && npm run detect:as-const && npm run check:docs",
    "ci:test": "npm run test:run",
    "ci:build": "npm run build",
    "ci:check": "npm run ci:quality && npm run ci:test && npm run ci:build",
    "ci:fix": "npm run lint:fix && npm run clean:fix && npm run ci:check",
    "ci:fast": "npm run type-check && npm run lint && npm run test:run",
    "ci:full": "npm run ci:check && npm run audit:full",
    "debug:ci": "node scripts/debug-ci.mjs",
    "prepare": "husky",
    "pre-commit": "npm run clean:check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:all": "node scripts/check-docs.mjs --all"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.22.0",
    "@azure/msal-react": "^5.7.1",
    "@stockhub/design-system": "github:SandrineCipolla/stockhub_design_system#v2.0.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "@humanfs/node": "^0.16.8",
    "postcss-selector-parser": "^6.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
